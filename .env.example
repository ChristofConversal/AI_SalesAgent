# Agent
# auto     = Claude als er een sleutel is, anders vooraf geschreven antwoorden
# claude   = altijd Claude
# scripted = altijd vooraf geschreven antwoorden (geen API-kosten)
COPILOT_MODE=auto
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
COPILOT_LIVE_EFFORT=low

# Opslag: leeg = lokaal bestand data/store.json
# Lokale Supabase (npx supabase start) geeft deze waarden:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
